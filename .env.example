# ==========================================================
# Daily Collection Finance Manager — Environment Example
# ==========================================================

# Database Mode: 'turso' for Cloud Database, 'local' for local file SQLite
DATABASE_MODE=turso

# Turso Cloud Database Credentials
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
TURSO_API_TOKEN=your-turso-platform-api-token

# Local Database Fallback
LOCAL_DB_PATH=./data/finance.db

# Server Configuration
PORT=5000
NODE_ENV=development
